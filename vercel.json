{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "^/(_next|favicon\\.ico|logo|public)(.*)",
      "status": 404
    },
    {
      "src": "^/((?!\\.json$|.*\\.\\w+$).*)$",
      "dest": "/api"
    },
    {
      "src": "(.*)",
      "dest": "/api/$1"
    }
  ]
}
